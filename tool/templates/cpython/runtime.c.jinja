    // m_size
    0,
    // m_methods
    NULL,
    // m_slots
    {{lib_name}}_module_slots,
    // m_traverse
    NULL,
    // m_clear
    NULL,
    // m_free
    {{lib_name}}_free,
};

PyMODINIT_FUNC PyInit_{{lib_name}}() {
    return PyModuleDef_Init(&{{lib_name}}_module);
}