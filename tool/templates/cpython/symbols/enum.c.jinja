{% block header %}
#ifndef {{abi_name}}_PY_H
#define {{abi_name}}_PY_H

#include "include/{{abi_name}}.h"
#include "diplomat_runtime_common.h"

PyObject* {{abi_name}}_to_py({{abi_name}} enum_in);
int {{abi_name}}_from_py(PyObject* enum_obj, {{abi_name}}* enum_out);
int {{abi_name}}_init(PyObject* module);

#endif
{% endblock %}

{% block definition %}
#include "include/{{abi_name}}_Py.h"

PyObject* enum_class;

PyObject* {{abi_name}}_to_py({{abi_name}} enum_in) {
    if (enum_class == NULL) {
        PyErr_SetString(PyExc_RuntimeError, "enum_class is NULL, most likely {{abi_name}} did not initialize");
        return NULL;
    }

    // TODO: Verify bounds instead of casting
    PyObject* enum_arg = PyLong_FromLong((long)enum_in);
    if (enum_arg == NULL) {
        return NULL;
    }

    PyObject* py_out = PyObject_CallOneArg(enum_class, enum_arg);
    Py_DECREF(enum_arg);
    return py_out;
}

int {{abi_name}}_from_py(PyObject* enum_obj, {{abi_name}}* enum_out) {
    int instance_check = PyObject_IsInstance(enum_obj, diplomat_internals.enum_ty);
    if (instance_check == -1) {
        return -1;
    } else if (instance_check == 0) {
        PyErr_SetString(PyExc_TypeError, "Self type is not an instance of {{abi_name}}");
        return -1;
    }

    PyObject* value = PyObject_GetAttrString(enum_obj, "value");
    if (!value) {
        return -1;
    }
    
    long enum_val = PyLong_AsLong(value);
    Py_DECREF(value);
    if (PyErr_Occurred()) {
        return -1;
    }

    // FIXME: Maybe a manual conversion? Need to validate the bounds of the enum.
    *enum_out = ({{abi_name}})enum_val;
    return 0;
}

{% for m in methods %}
{% include "cpython/functions/method.c.jinja" %}
{% endfor %}

int {{abi_name}}_init(PyObject* module) {
    PyObject* enum_names_values = PyTuple_New({{def.variants.len()}});
    {% for v in def.variants %}
    PyObject* {{v.name}}_value = PyLong_FromLong({{v.discriminant}});
    if ({{v.name}}_value == NULL) {
        Py_DECREF(enum_names_values);
        return -1;
    }
    PyObject* {{v.name}}_name = PyUnicode_FromString("{{fmt.fmt_enum_variant(v)}}");
    
    PyObject* {{v.name}}_name_and_value = PyTuple_Pack(2, {{v.name}}_name, {{v.name}}_value);
    Py_DECREF({{v.name}}_name);
    Py_DECREF({{v.name}}_value);

    // SetItem steals, so we do not need to decref:
    PyTuple_SetItem(enum_names_values, {{loop.index0}}, {{v.name}}_name_and_value);
    {% endfor %}

    PyObject* enum_name = PyUnicode_FromString("{{name}}");
    // PyTuple_Pack creates strong references to the provided objects (this is equivalent to Py_BuildValue("(O)", enum_name)):
    PyObject* enum_args = PyTuple_Pack(2, enum_name, enum_names_values);
    // So we must decref the args:
    Py_DECREF(enum_name);
    Py_DECREF(enum_names_values);

    if (enum_args == NULL) {
        return -1;
    }

    // Python enums can be passed without us needing to hold a reference, so we just create straight from the `Enum` class:
    enum_class = PyObject_Call(diplomat_internals.enum_ty, enum_args, NULL);
    Py_DECREF(enum_args);
    if (enum_class == NULL) {
        return -1;
    }

    {% for m in methods %}
    {%- if m.inner.param_self.is_some() -%}
    PyObject* __{{m.name}}__py_method = PyDescr_NewMethod((PyTypeObject*) enum_class, &__{{m.name}}__py_def);
    {%- else -%}
    PyObject* __{{m.name}}__py_static_method = PyCMethod_New(&__{{m.name}}__py_def, NULL, module, NULL);
    if (__{{m.name}}__py_static_method == NULL) {
        return -1;
    }

    PyObject* __{{m.name}}__py_method = PyStaticMethod_New(__{{m.name}}__py_static_method);
    {%- endif %}
    if (!__{{m.name}}__py_method) {
        return -1;
    }
    {% if m.inner.param_self.is_none() %}
    Py_DECREF(__{{m.name}}__py_static_method);
    {% endif %}
    PyObject_SetAttrString(enum_class, "{{m.name}}", __{{m.name}}__py_method);
    {% endfor %}

    int enum_add_result = PyModule_AddObjectRef(module, "{{name}}", enum_class);
    Py_DECREF(enum_class);
    return enum_add_result;
}
{% endblock %}