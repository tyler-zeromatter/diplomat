{% block header %}
#ifndef {{abi_name}}_PY_H
#define {{abi_name}}_PY_H

#include "include/{{abi_name}}.h"
#include "diplomat_runtime_common.h"

int {{abi_name}}_init(PyObject* module);
#endif
{% endblock %}

{% block definition %}
#include "include/{{abi_name}}_Py.h"


{% for m in methods %}
{% include "cpython/functions/method.c.jinja" %}
{% endfor %}

struct PyMethodDef struct_tp_methods[] = {
    {%- for m in methods %}
    __{{m.name}}__py_def {%- if !loop.last -%}, {% endif -%}
    {%- endfor -%}
};

static PyType_Slot struct_slots[] = {
    {Py_tp_methods, struct_tp_methods},
    {0, NULL},
};

static PyType_Spec struct_spec = {
    // TODO: Add module name
    .name = "{{lib_name}}.{{name}}",
    // Negative because this is in *addition* to the base PyObject type:
    .basicsize = {% if fields.is_empty() -%} 0 {%- else -%} -sizeof({{abi_name}}) {%- endif -%},
    .itemsize = 0,
    .flags = Py_TPFLAGS_DEFAULT | Py_TPFLAGS_BASETYPE,
    .slots = struct_slots,
};

int {{abi_name}}_init(PyObject* module) {
    PyObject* struct_py = PyType_FromModuleAndSpec(module, &struct_spec, NULL);

    if (struct_py == NULL) {
        return -1;
    }

    PyModule_AddObjectRef(module, "{{abi_name}}", struct_py);

    return 0;
}
{% endblock %}