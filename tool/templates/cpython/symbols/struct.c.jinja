{%- import "../functions/method.c.jinja" as method -%}
{% block header %}
#ifndef {{abi_name}}_PY_H
#define {{abi_name}}_PY_H

#include "include/{{abi_name}}.h"
#include "diplomat_runtime_common.h"

int {{abi_name}}_init(PyObject* module);
#endif
{% endblock %}

{% block definition %}
#include "include/{{abi_name}}_Py.h"

static PyObject* struct_py = NULL;
static PyObject* (*struct_alloc)(PyTypeObject* self, Py_ssize_t nitems) = NULL;

PyObject* {{abi_name}}_to_py({{abi_name}} in) {
    if (struct_py == NULL) {
        PyErr_SetString(PyExc_RuntimeError, "Could not get {{abi_name}} Python type, module may not be initialized.");
        return NULL;
    }

    if (struct_alloc == NULL) {
        PyErr_SetString(PyExc_RuntimeError, "Could not get {{abi_name}} allocator, module may not be initialized.");
        return NULL;
    }

    // We use the built-in allocator because the constructor may have been overridden:
    PyObject* struct_obj = struct_alloc(struct_py, 1);
    if (struct_obj == NULL) {
        return NULL;
    }
    

    {{abi_name}}* self_data = ({{abi_name}}*)PyObject_GetTypeData(struct_obj, struct_py);
    if (self_data == NULL) {
        Py_DECREF(struct_obj);
        return NULL;
    }

    *self_data = in;

    struct_obj = PyObject_Init(struct_obj, struct_py);
    if (struct_obj == NULL) {
        return NULL;
    }
    return struct_obj;
}

int {{abi_name}}_from_py(PyObject* struct_obj, {{abi_name}}** struct_out) {
    int instance_check = PyObject_IsInstance(struct_obj, struct_py);
    if (instance_check == -1) {
        Py_DECREF(struct_obj);
        return -1;
    } else if (instance_check == 0) {
        PyErr_SetString(PyExc_TypeError, "Self type is not an instance of {{abi_name}}");
        Py_DECREF(struct_obj);
        return -1;
    }

    {{abi_name}}* self_data = ({{abi_name}}*)PyObject_GetTypeData(struct_obj, struct_py);
    Py_DECREF(struct_obj);
    *struct_out = self_data;

    return 0;
}


{% for m in methods %}
{{method::method_definition(m, abi_name)}}
{% endfor %}

static PyMethodDef struct_tp_methods[] = {
    {%- for m in methods %}
    {% filter indent(4) -%} {{method::method_declaration(m) -}} {%- endfilter -%} {%- if !loop.last -%}, {%- endif -%}
    {%- endfor %},
    {NULL}
};

static PyType_Slot struct_slots[] = {
    {Py_tp_methods, struct_tp_methods},
    {0, NULL},
};

static PyType_Spec struct_spec = {
    // TODO: Add module name
    .name = "{{lib_name}}.{{name}}",
    // Negative because this is in *addition* to the base PyObject type:
    .basicsize = {% if fields.is_empty() -%} 0 {%- else -%} -sizeof({{abi_name}}) {%- endif -%},
    .itemsize = 0,
    .flags = Py_TPFLAGS_DEFAULT | Py_TPFLAGS_BASETYPE,
    .slots = struct_slots,
};

int {{abi_name}}_init(PyObject* module) {
    struct_py = PyType_FromModuleAndSpec(module, &struct_spec, NULL);

    if (struct_py == NULL) {
        return -1;
    }

    struct_alloc = PyType_GetSlot((PyTypeObject*)struct_py, Py_tp_alloc);
    if (struct_alloc == NULL) {
        PyErr_SetString(PyExc_ImportError, "Could not get allocator for {{abi_name}}");
        return -1;
    }

    PyModule_AddObjectRef(module, "{{abi_name}}", struct_py);
    Py_DECREF(struct_py);

    return 0;
}
{% endblock %}